# ===========================================
# AI-Powered Personal Music Composer
# Environment Configuration
# ===========================================

# Application
APP_NAME=AI Music Composer
APP_ENV=development
DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# Frontend
VITE_API_URL=http://localhost:8000/api
VITE_APP_URL=http://localhost:5173

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=ai_music_composer

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# File Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage
# For Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# For AWS S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=

# Audio Settings
SOUNDFONT_PATH=./soundfonts/default.sf2
MAX_GENERATION_DURATION=300
MAX_UPLOAD_SIZE_MB=50

# AI Model Settings
AI_MODEL_TYPE=algorithmic
# Options: algorithmic, musicgen, custom
AI_MODEL_PATH=
AI_USE_GPU=false

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Admin
ADMIN_EMAIL=admin@aimusic.com
ADMIN_PASSWORD=admin123
